#!/bin/bash
# 진행 상황은 /var/log/cloud-init-output.log, 완료 표시는 /opt/openkache/STATUS.
# role=node는 cache-server 컨테이너를, role=loadgen은 experiment-runner 배포본만 준비한다.
# storage_engine=nvme면 node가 instance store를 포맷해 KV 저장소로 쓴다(docs/storage-nvme.md).
set -euxo pipefail

mkdir -p /opt/openkache
echo "booting" > /opt/openkache/STATUS
trap 'echo "failed" > /opt/openkache/STATUS' ERR

%{ if role == "loadgen" ~}
dnf install -y git java-21-amazon-corretto-devel
%{ else ~}
dnf install -y docker git
systemctl enable --now docker
%{ endif ~}

cd /opt/openkache
aws s3 cp --region ap-northeast-2 "s3://${results_bucket}/bundles/${source_commit}.bundle" repo.bundle
git init -q src
cd src
git fetch -q ../repo.bundle HEAD
git checkout -q --detach FETCH_HEAD
test "$(git rev-parse HEAD)" = "${source_commit}"

echo "building" > /opt/openkache/STATUS
%{ if role == "loadgen" ~}
# 연구 backend 준비(prepareResearchBackends)는 TCP 실험에 필요 없고 전체 테스트 컴파일이라 뺀다.
export GRADLE_USER_HOME=/opt/openkache/gradle
./gradlew --no-daemon :experiment-runner:installDist -x :experiment-runner:prepareResearchBackends
echo "ready" > /opt/openkache/STATUS
%{ else ~}
docker build -f deploy/docker/Dockerfile -t openkache-server .

%{ if server_mode == "b1" ~}
# B1 라우팅 클러스터(docs/protocol-v1.md §6). 모든 노드가 같은 hosts 순서를 읽어야 초기 표가 일치한다.
# B1Server는 hosts[node.id]에 bind하므로 host 네트워크로 띄운다(포트 공개는 보안그룹이 제한).
cat > /opt/openkache/b1.properties <<PROPS
node.id=${node_id - 1}
hosts=${b1_hosts}
client.port=7000
peer.port=7001
tablets.per.node=2
PROPS
docker run -d --name openkache-server --restart unless-stopped \
  --network host \
  --entrypoint java \
  -v /opt/openkache/b1.properties:/app/config/b1.properties:ro \
  openkache-server \
  -Xms2g -Xmx2g -cp '/app/lib/*' io.openkache.server.routing.B1ServerMain /app/config/b1.properties

for _ in $(seq 1 30); do
  if timeout 2 bash -c "</dev/tcp/${self_ip}/7000" 2>/dev/null; then
    echo "ready" > /opt/openkache/STATUS
    exit 0
  fi
  sleep 2
done
echo "failed" > /opt/openkache/STATUS
exit 1
%{ else ~}
sed -i "s/^node.id=.*/node.id=${node_id}/" deploy/docker/server.properties
%{ if storage_engine == "nvme" ~}
# root EBS가 아닌 instance store를 모델명으로 찾는다. 정지하면 내용이 지워지는 장치다.
dev=$(lsblk -dnpo NAME,MODEL | awk '/Instance Storage/ {print $1; exit}')
test -n "$dev"
mkfs.xfs -f "$dev"
mkdir -p /mnt/nvme
mount -o noatime "$dev" /mnt/nvme
mkdir -p /mnt/nvme/kv
chmod 1777 /mnt/nvme/kv
printf 'storage.engine=nvme\nstorage.path=/data\nstorage.capacity.bytes=%s\n' ${storage_capacity_bytes} \
  >> deploy/docker/server.properties
%{ endif ~}
# 메모리·nvme 비교가 같은 heap에서 이뤄지도록 고정한다(nvme 색인도 heap에 있다).
docker run -d --name openkache-server --restart unless-stopped \
  -p 7000:7000 -p 7001:7001 -p 9091:9091 \
  -e JAVA_OPTS="-Xms2g -Xmx2g" \
  -v /opt/openkache/src/deploy/docker/server.properties:/app/config/server.properties:ro \
%{ if storage_engine == "nvme" ~}
  -v /mnt/nvme/kv:/data \
%{ endif ~}
  openkache-server

for _ in $(seq 1 30); do
  if curl -fsS http://127.0.0.1:9091/metrics > /dev/null; then
    echo "ready" > /opt/openkache/STATUS
    exit 0
  fi
  sleep 2
done
echo "failed" > /opt/openkache/STATUS
exit 1
%{ endif ~}
%{ endif ~}
